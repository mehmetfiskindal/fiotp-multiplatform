{
  "name": "gea-fiotp-gea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node patches/geastack-apple-macos-password.mjs && node patches/geastack-apple-ios-build.mjs && node patches/geastack-linux-build.mjs && node patches/geastack-sailfish-build.mjs",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/otp.test.ts && npx tsx tests/pagination.test.ts && sh scripts/test-native.sh",
    "dev": "gea dev",
    "build": "gea build --target web",
    "build:macos": "gea build --target macos",
    "build:ios": "node_modules/@geastack/apple/targets/ios/build-ios.sh fiotp-gea simulator && node scripts/ios-postbuild.mjs",
    "build:ios:device": "node_modules/@geastack/apple/targets/ios/build-ios.sh fiotp-gea device && node scripts/ios-postbuild.mjs",
    "build:android": "cd android && ./gradlew assembleDebug",
    "test:android": "cd android && ./gradlew testDebugUnitTest",
    "build:linux": "bash scripts/build-linux.sh",
    "build:sailfish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sailfish.ps1",
    "build:windows": "gea build --target windows",
    "run:windows": "gea run --target windows"
  },
  "dependencies": {
    "@geajs/core": "latest",
    "@geastack/apple": "^0.2.8",
    "@geastack/cli": "^0.1.78",
    "@geastack/core": "^0.1.12",
    "@geastack/targets": "^0.1.77"
  },
  "devDependencies": {
    "@geajs/vite-plugin": "^1.4.1",
    "@geastack/linux": "^0.1.1",
    "@geastack/windows": "^0.1.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "gea": {
    "id": "fiotp-gea",
    "bundleId": "com.fiskindal.fiotp",
    "name": "FiOTP",
    "description": "Secure TOTP & HOTP authenticator vault.",
    "entry": "src/index.tsx",
    "targets": {
      "web": true,
      "esp32": false,
      "rp2350": false,
      "geaos": false,
      "macos": true,
      "ios": true,
      "raspberry-pi-os": true,
      "android": false,
      "windows": true
    },
    "nativeSources": [
      "native/fiotp_host.mm",
      "native/fiotp_host_windows.cpp"
    ],
    "icons": {
      "512": "icons/icon-source.png"
    },
    "sailfish": {
      "organizationName": "com.fiskindal",
      "applicationName": "fiotp",
      "permissions": [],
      "devicePixelRatio": 2
    },
    "ota": {
      "ble": true
    }
  },
  "license": "MIT"
}
